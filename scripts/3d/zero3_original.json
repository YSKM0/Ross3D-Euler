{
  "bf16": { "enabled": true },
  "fp16": { "enabled": false },

  "zero_optimization": {
    "stage": 3,

    "offload_optimizer": { "device": "none", "pin_memory": true },
    "offload_param": { "device": "none", "pin_memory": true },

    "overlap_comm": false,
    "ignore_unused_parameters": true,
    "contiguous_gradients": true,
    "reduce_scatter": false,
    "allgather_partitions": true,

    "allgather_bucket_size": 12845056,
    "reduce_bucket_size": 12845056,
    "prefetch_bucket_size": 0,
    "param_persistence_threshold": 35840,

    "sub_group_size": 1000000000,

    "gather_16bit_weights_on_model_save": true,

    "use_all_reduce_for_fetch_params": false
  },

    "activation_checkpointing": {
    "partition_activations": true,
    "contiguous_memory_optimization": true,
    "synchronize_checkpoint_boundary": true
  },

  "gradient_accumulation_steps": "auto",
  "gradient_clipping": "auto",
  "steps_per_print": 100,
  "train_batch_size": "auto",
  "train_micro_batch_size_per_gpu": "auto",
  "wall_clock_breakdown": false
}